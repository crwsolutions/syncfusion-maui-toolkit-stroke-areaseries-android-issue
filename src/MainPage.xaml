<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:syncfusion_maui_toolkit_stroke_areaseries_android_issue.ViewModels"
             x:Class="syncfusion_maui_toolkit_stroke_areaseries_android_issue.MainPage"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             x:DataType="vm:MainPageViewModel" Background="White"
             >

    <VerticalStackLayout Padding="6">
        <Label Text="AreaSeries" FontAttributes="Bold" Margin="0,0,0,12" />
        <chart:SfCartesianChart HeightRequest="200" Margin="3,0,3,6">

            <chart:SfCartesianChart.XAxes>
                <chart:NumericalAxis ShowMajorGridLines="false" Interval="2" PlotOffsetStart="8" PlotOffsetEnd="8">
                    <chart:NumericalAxis.LabelStyle>
                        <chart:ChartAxisLabelStyle TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray100}}" />
                    </chart:NumericalAxis.LabelStyle>
                </chart:NumericalAxis>
            </chart:SfCartesianChart.XAxes>

            <chart:SfCartesianChart.YAxes>
                <chart:NumericalAxis ShowMajorGridLines="False">
                    <chart:NumericalAxis.LabelStyle>
                        <chart:ChartAxisLabelStyle LabelFormat="C0" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray100}}" />
                    </chart:NumericalAxis.LabelStyle>
                </chart:NumericalAxis>
            </chart:SfCartesianChart.YAxes>


            <chart:SfCartesianChart.Series>
                <chart:AreaSeries Label="Income"
                  EnableTooltip="True" EnableAnimation="True" StrokeWidth="4"
                  ItemsSource="{Binding IncomeData, Mode=OneWay}"
                  Opacity="1"
                  ShowMarkers="False"
                  XBindingPath="Year"
                  YBindingPath="Amount"
                  LegendIcon="SeriesType"
                  Stroke="#FF000000" >
                    <chart:AreaSeries.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{StaticResource IncomeGradientStartColor}" Offset="0.0" />
                            <GradientStop Color="{StaticResource IncomeGradientEndColor}" Offset="1.0" />
                        </LinearGradientBrush>
                    </chart:AreaSeries.Fill>
                </chart:AreaSeries>
            </chart:SfCartesianChart.Series>
        </chart:SfCartesianChart>

    </VerticalStackLayout>

</ContentPage>
